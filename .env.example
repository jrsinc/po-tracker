# Copy to .env (never commit .env). Values are read at build time.
# Microsoft Entra ID (Azure AD) - see README "Entra app registration"
EXPO_PUBLIC_TENANT_ID=e98f8ec2-bb19-4dfc-a89a-e07adee53b2a
EXPO_PUBLIC_CLIENT_ID=00000000-0000-0000-0000-000000000000

# SharePoint target
EXPO_PUBLIC_SP_HOST=jrsllc1.sharepoint.com
EXPO_PUBLIC_SP_SITE_PATH=/sites/jrsllc
EXPO_PUBLIC_SP_LIST_NAME=PO Tracking 2026 JRS INC
# Document library you create for PO files (display name)
EXPO_PUBLIC_SP_LIBRARY_NAME=PO Documents 2026
# Optional folder inside the library that holds the per-PO folders (empty = library root)
EXPO_PUBLIC_SP_BASE_FOLDER=
# IANA time zone of the SharePoint site (Site settings > Regional settings). Used for date-only columns.
EXPO_PUBLIC_SP_TIME_ZONE=America/Los_Angeles
